# =========================
# Strict whitelist strategy
# =========================
# Ignore everything by default, then re-allow only what is essential
# for runtime/maintenance of v2 + migrations + README.

*

# Always keep gitignore and root docs/config needed to run workspace scripts
!.gitignore
!README.md
!package.json

# Keep active app (v2)
!v2/
!v2/backend/
!v2/backend/**
!v2/frontend/
!v2/frontend/**

# -------------------------
# Re-ignore generated files
# -------------------------
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.nyc_output/
**/.cache/
**/tmp/
**/temp/
**/*.log
**/*.tmp
**/*.tsbuildinfo
**/yarn.lock

# Keep lockfiles required by CI/deploy reproducibility
!package-lock.json
!v2/backend/package-lock.json
!v2/frontend/package-lock.json

# Environment and secrets
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json
auth.json

# OS / IDE noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
